# BhashaVerse 2.0 Environment Configuration
# Copy this file to .env or configure in Streamlit secrets (.streamlit/secrets.toml)

# Moderator Secret Key (for accessing Module 4: Moderation Console)
MODERATOR_KEY=bhashaverse_maintainer_2026

# Database Path (optional override, defaults to data/bhashaverse.db)
# BHASHAVERSE_DB_PATH=data/bhashaverse.db

# LLM / Chatbot API Keys (Optional - BhashaAI runs 100% offline if omitted)
# Google Gemini API Key
GEMINI_API_KEY=
# Groq API Key (Llama 3.3 70B)
# GROQ_API_KEY=
# OpenAI API Key (GPT-4o mini)
# OPENAI_API_KEY=
